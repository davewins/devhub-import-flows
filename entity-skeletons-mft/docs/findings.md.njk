{#- Derives entity names, links, tags, expiry and findings from the Command Center REST responses (values.servers etc.).
    (((inst + "-" + "kind" + "-" + (expr)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "")) and ((expr) | lower | replace(r/[^a-z0-9]+/g, "-") | replace(r/^-+|-+$/g, "")) are expanded by tools/build-skeleton.mjs. Pure data: nothing secret is read. -#}
{%- macro isoDays(iso) -%}
{%- set p = iso.split("-") -%}
{%- set m = p[1] | int -%}{%- set d = p[2].split("T")[0] | int -%}
{%- set y = (p[0] | int) - 1 if m <= 2 else (p[0] | int) -%}
{%- set era = y // 400 -%}{%- set yoe = y - era * 400 -%}
{%- set doy = (153 * ((m + 9) % 12) + 2) // 5 + d - 1 -%}
${{ era * 146097 + yoe * 365 + yoe // 4 - yoe // 100 + doy }}
{%- endmacro -%}
{%- set r = values.repoUrl | parseRepoUrl -%}
{%- set scm = values.scm -%}
{%- set ns = r.workspace if scm == "bitbucket-cloud" else (r.project if scm == "bitbucket-server" else r.owner) -%}
{%- set webBase = ("https://" + r.host + "/projects/" + ns + "/repos/" + r.repo) if scm == "bitbucket-server" else ("https://" + r.host + "/" + ns + "/" + r.repo) -%}
{%- set treeSuf = ("?at=refs/heads/" + values.branch) if scm == "bitbucket-server" else "" -%}
{%- if scm == "github" -%}{%- set treePre = webBase + "/tree/" + values.branch + "/" -%}
{%- elif scm == "gitlab" -%}{%- set treePre = webBase + "/-/tree/" + values.branch + "/" -%}
{%- elif scm == "bitbucket-cloud" -%}{%- set treePre = webBase + "/src/" + values.branch + "/" -%}
{%- elif scm == "bitbucket-server" -%}{%- set treePre = webBase + "/browse/" -%}
{%- else -%}{%- set treePre = webBase + "/src/branch/" + values.branch + "/" -%}{%- endif -%}
{%- set inst = values.instance if values.instance else "mft" -%}
{%- set ccName = (inst + "-command-center") | lower | replace(r/[^a-z0-9_.-]+/g, "-") | truncate(63, true, "") -%}
{%- set ccUrl = values.ccUrl if values.ccUrl else "" -%}
{%- set ccVersion = ((values.version.message if values.version else "") | default("")) | trim -%}
{%- set warnDays = (values.warnDays | int) if values.warnDays else 30 -%}
{#- "now" comes from the Date header of the Command Center response (Wed, 11 Nov 2026 18:08:07 GMT): templates have no clock -#}
{%- set months = { "Jan": "01", "Feb": "02", "Mar": "03", "Apr": "04", "May": "05", "Jun": "06", "Jul": "07", "Aug": "08", "Sep": "09", "Oct": "10", "Nov": "11", "Dec": "12" } -%}
{%- set dparts = values.ccDate.split(" ") if values.ccDate else [] -%}
{%- set nowOk = dparts.length >= 5 and months[dparts[2]] -%}
{%- set nowIso = (dparts[3] + "-" + months[dparts[2]] + "-" + dparts[1]) if nowOk else "" -%}
{%- set nowDn = (isoDays(nowIso) | int) if nowOk else 0 -%}
{%- set protoMap = { "all": "ftp ftps sftp https", "ftp": "ftp ftps", "secure": "ftps sftp https", "https": "https", "ssh": "sftp", "sftp": "sftp", "ftps": "ftps" } -%}
{%- set findings = [] -%}
{#- Relationship model: edges flow outward from Command Center: CC -> servers / Internet Server -> listeners, partner users, transfers, certificates. -#}
{%- set ccDeps = [] -%}
{#- Internet Server hosts: values.isHosts = "host[:httpsPort],host[:httpsPort],..." (up to 8; listener reads are values.isFtp1..8 / isSsh1..8). -#}
{%- set hostDefs = [] -%}
{%- set ftpList = [values.isFtp1, values.isFtp2, values.isFtp3, values.isFtp4, values.isFtp5, values.isFtp6, values.isFtp7, values.isFtp8] -%}
{%- set sshList = [values.isSsh1, values.isSsh2, values.isSsh3, values.isSsh4, values.isSsh5, values.isSsh6, values.isSsh7, values.isSsh8] -%}
{%- if values.isHosts -%}
  {%- for e in (values.isHosts | replace(" ", "")).split(",") -%}
    {%- set hp = e.split(":") -%}
    {%- if hp[0] != "" and loop.index0 < 8 -%}
      {%- set _ = hostDefs.push({ "h": hp[0], "port": (hp[1] if hp.length > 1 else (values.httpsPort | default("7443") | string)), "ftp": ftpList[loop.index0], "ssh": sshList[loop.index0], "eps": [] }) -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- set isName = (((inst + "-" + "isrv" + "-" + (hostDefs[0].h)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "")) if hostDefs.length > 0 else "" -%}
{#- Shared (cluster-wide) things every Internet Server node serves: partner users, transfers, default HTTPS key. -#}
{%- set isDeps = [] -%}
{#- ---- licence ---- -#}
{%- set licExp = "" -%}{%- set licDl = 0 -%}
{%- if values.license and values.license.licenseExpirationDate -%}
  {%- set lp = values.license.licenseExpirationDate.split(" ") -%}
  {%- if lp.length >= 6 and months[lp[1]] -%}{%- set licExp = lp[5] + "-" + months[lp[1]] + "-" + lp[2] -%}{%- set licDl = (isoDays(licExp) | int) - nowDn -%}{%- endif -%}
{%- endif -%}
{#- ---- certificates ---- -#}
{%- set certRows = [] -%}
{%- set allKeys = [] -%}
{%- for k in (values.systemKeys or []) -%}{%- set _ = allKeys.push({ "k": k, "kind": "system" }) -%}{%- endfor -%}
{%- for k in (values.publicKeys or []) -%}{%- set _ = allKeys.push({ "k": k, "kind": "stored" }) -%}{%- endfor -%}
{%- for a in allKeys -%}
  {%- set k = a.k -%}
  {%- set e = k.keyExpirationDate | default("") -%}
  {%- set dl = ((isoDays(e) | int) - nowDn) if (e != "" and nowOk) else 0 -%}
  {%- set st = "" -%}
  {%- if e != "" and nowOk and dl < 0 -%}{%- set st = "expired" -%}{%- elif e != "" and nowOk and dl <= warnDays -%}{%- set st = "expiring" -%}{%- endif -%}
  {%- set owner = (k.userOrServerName | default("")) if a.kind == "stored" else "" -%}
  {%- set label = k.alias if k.alias else (owner if owner != "" else k.keyId) -%}
  {%- set tags = ["certificate", ((k.keyType) | lower | replace(r/[^a-z0-9]+/g, "-") | replace(r/^-+|-+$/g, ""))] -%}
  {%- if st != "" -%}{%- set _ = tags.push("cert-" + st) -%}{%- endif -%}
  {%- if e == "" -%}{%- set _ = tags.push("no-expiry-recorded") -%}{%- endif -%}
  {%- set _ = certRows.push({ "id": k.keyId, "name": (((inst + "-" + "cert" + "-" + (k.keyId)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "")), "type": k.keyType, "kind": a.kind, "owner": owner, "label": label, "expires": e, "dl": dl, "st": st, "tags": tags, "subject": k.subjectDN | default(""), "issuer": k.issuerName | default(""), "isDefault": k.defaultKeyFlag == "Yes", "desc": k.description | default("") }) -%}
  {%- if st != "" -%}{%- set _ = findings.push({ "sev": "high" if st == "expired" else "medium", "entity": (((inst + "-" + "cert" + "-" + (k.keyId)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "")), "text": k.keyType + " certificate " + label + (" EXPIRED " if st == "expired" else " expires ") + (e | truncate(10, true, "")) + " (" + (dl | string) + " days)" }) -%}{%- endif -%}
{%- endfor -%}
{#- ---- servers ---- -#}
{%- set svs = [] -%}
{%- for s in (values.servers or []) -%}
  {%- if s.serverType != "LOCAL" -%}
    {%- set n = s.serverName -%}{%- set typ = s.serverType -%}
    {%- set sec = (s.psConnectionSecurityType | default("")) if typ == "Platform Server" else ((s.ftpConnectionSecurityType | default("")) if typ == "FTP" else (("TLS" if (s.ipAddressOrName | default("")).split("https:").length > 1 else "None") if typ == "HTTP" else ("SSH" if typ == "SSH" else ""))) -%}
    {%- set clientType = "Platform Server" if (typ == "Platform Server" and s.psSystemKey and s.psSystemKey != "None") else ("FTP" if (typ == "FTP" and sec != "" and sec != "None") else "") -%}
    {%- set deps = [] -%}{%- set exps = [] -%}{%- set dls = [] -%}
    {%- for c in certRows -%}
      {%- if (c.kind == "stored" and c.owner == n) or (c.kind == "system" and c.isDefault and clientType != "" and c.type == clientType) -%}
        {%- set _ = deps.push("resource:default/" + c.name) -%}
        {%- if c.expires != "" -%}{%- if exps.length == 0 -%}{%- set _ = exps.push(c.expires) -%}{%- set _ = dls.push(c.dl) -%}{%- elif c.dl < dls[0] -%}{%- set _ = exps.pop() -%}{%- set _ = dls.pop() -%}{%- set _ = exps.push(c.expires) -%}{%- set _ = dls.push(c.dl) -%}{%- endif -%}{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- set exp = exps[0] if exps.length > 0 else "" -%}{%- set dl = dls[0] if dls.length > 0 else 0 -%}
    {%- set st = "" -%}
    {%- if exp != "" and nowOk and dl < 0 -%}{%- set st = "expired" -%}{%- elif exp != "" and nowOk and dl <= warnDays -%}{%- set st = "expiring" -%}{%- endif -%}
    {%- set tags = ["mft-server", ((typ) | lower | replace(r/[^a-z0-9]+/g, "-") | replace(r/^-+|-+$/g, ""))] -%}
    {%- if sec != "" -%}{%- set _ = tags.push(((sec) | lower | replace(r/[^a-z0-9]+/g, "-") | replace(r/^-+|-+$/g, ""))) -%}{%- endif -%}
    {%- set insecure = (sec == "None" and (typ == "Platform Server" or typ == "FTP" or typ == "HTTP")) -%}
    {%- if insecure -%}{%- set _ = tags.push("insecure-transport") -%}{%- set _ = findings.push({ "sev": "medium", "entity": (((inst + "-" + "srv" + "-" + (n)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "")), "text": "Server " + n + " (" + typ + ") is defined without transport security" }) -%}{%- endif -%}
    {%- if typ == "SSH" -%}{%- set _ = tags.push("sftp") -%}{%- endif -%}
    {%- if s.disableFlag == "Yes" -%}{%- set _ = tags.push("disabled") -%}{%- endif -%}
    {%- if st != "" -%}{%- set _ = tags.push("cert-" + st) -%}{%- endif -%}
    {%- if exps.length == 0 and typ != "SSH" and sec != "None" and sec != "" -%}{%- set _ = findings.push({ "sev": "low", "entity": (((inst + "-" + "srv" + "-" + (n)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "")), "text": "No stored certificate found for " + n + "; expiry unknown" }) -%}{%- endif -%}
    {%- set _ = svs.push({ "name": (((inst + "-" + "srv" + "-" + (n)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "")), "n": n, "typ": typ, "sec": sec, "addr": s.ipAddressOrName | default(""), "port": s.ipPort | default("") | string, "desc": s.description | default(""), "good": s.ServerStatusGoodCount | default(""), "fail": s.ServerStatusFailCount | default(""), "deps": deps, "exp": exp, "dl": dl, "tags": tags, "insecure": insecure }) -%}
  {%- endif -%}
{%- endfor -%}
{%- for sv in svs -%}{%- set _ = ccDeps.push("resource:default/" + sv.name) -%}{%- endfor -%}
{%- for hd in hostDefs -%}{%- set _ = ccDeps.push("resource:default/" + (((inst + "-" + "isrv" + "-" + (hd.h)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, ""))) -%}{%- endfor -%}
{#- ---- internet server protocol endpoints ---- -#}
{%- set eps = [] -%}
{%- for hd in hostDefs -%}
  {%- set h = hd.h -%}
  {%- set defs = [] -%}
  {%- if hd.ftp and hd.ftp.enabled == "Yes" -%}
    {%- if hd.ftp.sslOnlyConnections != "Yes" -%}{%- set _ = defs.push({ "proto": "ftp", "port": hd.ftp.ipPort | string, "key": "", "ccc": "" }) -%}{%- endif -%}
    {%- if hd.ftp.tlsIPPort and (hd.ftp.tlsIPPort | string) != "0" -%}{%- set _ = defs.push({ "proto": "ftps", "port": hd.ftp.tlsIPPort | string, "key": "FTP", "ccc": hd.ftp.clearCommandChannel }) -%}{%- endif -%}
  {%- endif -%}
  {%- if hd.ssh and hd.ssh.enabled == "Yes" -%}{%- set _ = defs.push({ "proto": "sftp", "port": hd.ssh.ipPort | string, "key": "SSH", "ccc": "" }) -%}{%- endif -%}
  {%- if values.includeIS != false -%}{%- set _ = defs.push({ "proto": "https", "port": hd.port, "key": "", "ccc": "" }) -%}{%- endif -%}
  {%- for d in defs -%}
    {%- set pr = d.proto -%}
    {%- set e = "" -%}{%- set dl = 0 -%}{%- set cid = "" -%}
    {%- if d.key != "" -%}{%- for c in certRows -%}{%- if c.kind == "system" and c.isDefault and c.type == d.key -%}{%- set e = c.expires -%}{%- set dl = c.dl -%}{%- set cid = c.id -%}{%- endif -%}{%- endfor -%}{%- endif -%}
    {%- set st = "" -%}
    {%- if e != "" and nowOk and dl < 0 -%}{%- set st = "expired" -%}{%- elif e != "" and nowOk and dl <= warnDays -%}{%- set st = "expiring" -%}{%- endif -%}
    {%- set tags = ["mft-protocol-endpoint", pr] -%}
    {%- if pr == "ftp" -%}{%- set _ = tags.push("insecure-transport") -%}{%- set _ = tags.push("clear-ftp") -%}{%- set _ = findings.push({ "sev": "medium", "entity": (((inst + "-" + "ep" + "-" + (h + "-" + pr)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "")), "text": "Plain (clear-text) FTP listener enabled on " + h + ":" + d.port }) -%}{%- endif -%}
    {%- if d.ccc == "Yes" -%}{%- set _ = tags.push("clear-command-channel") -%}{%- set _ = findings.push({ "sev": "medium", "entity": (((inst + "-" + "ep" + "-" + (h + "-" + pr)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "")), "text": "FTPS on " + h + " allows a clear command channel" }) -%}{%- endif -%}
    {%- if st != "" -%}{%- set _ = tags.push("cert-" + st) -%}{%- endif -%}
    {%- if pr == "https" -%}{%- set _ = findings.push({ "sev": "low", "entity": (((inst + "-" + "ep" + "-" + (h + "-" + pr)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "")), "text": "HTTPS listener " + h + ":" + d.port + ": the certificate lives in the Tomcat keystore, not in REST, so its expiry is not tracked" }) -%}{%- endif -%}
    {%- set _ = eps.push({ "name": (((inst + "-" + "ep" + "-" + (h + "-" + pr)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "")), "host": h, "proto": pr, "port": d.port, "insecure": pr == "ftp", "exp": e, "dl": dl, "certId": cid, "tags": tags }) -%}{%- set _ = hd.eps.push("resource:default/" + (((inst + "-" + "ep" + "-" + (h + "-" + pr)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, ""))) -%}
  {%- endfor -%}
  {%- endfor -%}
{%- if isName != "" -%}{%- for c in certRows -%}{%- if c.kind == "system" and c.isDefault and c.type == "HTTPS" -%}{%- set _ = isDeps.push("resource:default/" + c.name) -%}{%- endif -%}{%- endfor -%}{%- endif -%}
{#- ---- partner users ---- -#}
{%- set uss = [] -%}
{%- for u in (values.users or []) -%}
  {%- if u.userType != "Non-File Share User" and u.userType != "Power User" -%}
    {%- set prot = (u.clientProtocolsAllowed | default("")) -%}
    {%- set allowed = (protoMap[prot | lower] or "").split(" ") -%}
    {%- set deps = [] -%}
    {%- set tags = ["mft-user"] -%}
    {%- for a in allowed -%}{%- if a != "" -%}{%- set _ = tags.push(a) -%}{%- endif -%}{%- endfor -%}
    {%- if "ftp" in allowed -%}{%- set _ = tags.push("insecure-transport") -%}{%- set _ = findings.push({ "sev": "medium", "entity": (((inst + "-" + "user" + "-" + (u.userId)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "")), "text": "User " + u.userId + " may connect with clear FTP (clientProtocolsAllowed=" + prot + ")" }) -%}{%- endif -%}
    {%- if u.disableUser == "Yes" or u.lockUser == "Yes" -%}{%- set _ = tags.push("disabled") -%}{%- endif -%}
    {%- set _ = uss.push({ "id": u.userId, "name": (((inst + "-" + "user" + "-" + (u.userId)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "")), "full": u.fullName | default(""), "type": u.userType, "prot": prot, "allowed": allowed, "last": u.dateLastAccess | default(""), "ip": u.restrictedIPAddress | default(""), "deps": deps, "tags": tags }) -%}
    {%- if isName != "" -%}{%- set _ = isDeps.push("resource:default/" + (((inst + "-" + "user" + "-" + (u.userId)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, ""))) -%}{%- else -%}{%- set _ = ccDeps.push("resource:default/" + (((inst + "-" + "user" + "-" + (u.userId)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, ""))) -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{#- ---- Platform Server transfers ---- -#}
{%- set pts = [] -%}
{%- for t in (values.psTransfers or []) -%}
  {%- set tname = (((inst + "-" + "ps" + "-" + (t.TransferID)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "")) -%}
  {%- set ini = t.PServerName | default("") -%}{%- set rs = "" -%}
  {%- for s in values.servers -%}{%- if s.serverType == "Platform Server" and s.ipAddressOrName == t.ResponderHostName and (s.ipPort | string) == (t.ResponderPortNumber | string) -%}{%- set rs = s.serverName -%}{%- endif -%}{%- endfor -%}
  {%- set ssl = t.UsingSSL | default("No") -%}{%- set pdir = t.TransferDirection | default("unknown") -%}
  {%- set deps = [] -%}{%- set exps = [] -%}{%- set dls = [] -%}
  {%- for sv in svs -%}{%- if sv.n == ini or (sv.n == rs and rs != ini) -%}{%- if sv.n == ini -%}{%- set _ = sv.deps.push("component:default/" + tname) -%}{%- else -%}{%- set _ = deps.push("resource:default/" + sv.name) -%}{%- endif -%}
    {%- if sv.exp != "" and ssl != "No" -%}{%- if exps.length == 0 -%}{%- set _ = exps.push(sv.exp) -%}{%- set _ = dls.push(sv.dl) -%}{%- elif sv.dl < dls[0] -%}{%- set _ = exps.pop() -%}{%- set _ = dls.pop() -%}{%- set _ = exps.push(sv.exp) -%}{%- set _ = dls.push(sv.dl) -%}{%- endif -%}{%- endif -%}
  {%- endif -%}{%- endfor -%}
  {%- set exp = exps[0] if exps.length > 0 else "" -%}{%- set dl = dls[0] if dls.length > 0 else 0 -%}
  {%- set st = "" -%}
  {%- if exp != "" and nowOk and dl < 0 -%}{%- set st = "expired" -%}{%- elif exp != "" and nowOk and dl <= warnDays -%}{%- set st = "expiring" -%}{%- endif -%}
  {%- set tags = ["file-transfer", "platform-server", ((pdir) | lower | replace(r/[^a-z0-9]+/g, "-") | replace(r/^-+|-+$/g, ""))] -%}
  {%- if ssl == "No" -%}{%- set _ = tags.push("insecure-transport") -%}{%- set _ = findings.push({ "sev": "medium", "entity": (((inst + "-" + "ps" + "-" + (t.TransferID)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "")), "text": "Transfer " + t.TransferID + " (" + ini + " to " + t.ResponderHostName + ":" + (t.ResponderPortNumber | string) + ") is sent without SSL/TLS" }) -%}
  {%- else -%}{%- set _ = tags.push("implicit-ssl" if ssl == "Yes" else ((ssl) | lower | replace(r/[^a-z0-9]+/g, "-") | replace(r/^-+|-+$/g, ""))) -%}{%- endif -%}
  {%- if t.Hold == "Yes" -%}{%- set _ = tags.push("held") -%}{%- endif -%}
  {%- if st != "" -%}{%- set _ = tags.push("cert-" + st) -%}{%- endif -%}
  {%- set _ = pts.push({ "id": t.TransferID, "name": (((inst + "-" + "ps" + "-" + (t.TransferID)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "")), "desc": t.Description | default(""), "dir": t.TransferDirection | default(""), "ini": ini, "src": t.InitiatorFileName | default(""), "respHost": t.ResponderHostName | default(""), "respPort": t.ResponderPortNumber | default("") | string, "respFile": t.Responder_FileName_Command | default(""), "ssl": ssl, "enc": t.EncryptionMethod | default(""), "comp": t.DefaultCompression | default(""), "hold": t.Hold | default("No"), "last": t.DateLastProcessed | default(""), "deps": deps, "exp": exp, "dl": dl, "tags": tags }) -%}
{%- endfor -%}
{#- ---- Internet Server transfers (inbound *LOCAL, outbound to a partner server) ---- -#}
{%- set its = [] -%}
{%- for t in (values.isTransfers or []) -%}
  {%- set tname = (((inst + "-" + "is" + "-" + (t.transferId)) | lower | replace(r/[^a-z0-9_.-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "")) -%}{%- set idir = t.transferDirection | default("unknown") -%}{%- set srvn = t.serverName | default("") -%}{%- set outbound = (srvn != "*LOCAL" and srvn != "") -%}
  {%- set deps = [] -%}{%- set exps = [] -%}{%- set dls = [] -%}
  {%- set tags = ["file-transfer", "internet-server", "outbound" if outbound else "inbound", ((idir) | lower | replace(r/[^a-z0-9]+/g, "-") | replace(r/^-+|-+$/g, ""))] -%}
  {%- if outbound -%}
