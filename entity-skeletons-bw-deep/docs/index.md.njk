{#- Computes locations, names and lists; everything below is generated from the BW project. -#}
{%- set r = values.repoUrl | parseRepoUrl -%}
{%- set scm = values.scm -%}
{%- set host = r.host -%}
{#- namespace in the repository path: owner/group, Bitbucket Cloud workspace, or Bitbucket Server project key -#}
{%- set ns = r.workspace if scm == "bitbucket-cloud" else (r.project if scm == "bitbucket-server" else r.owner) -%}
{%- set webBase = ("https://" + host + "/projects/" + ns + "/repos/" + r.repo) if scm == "bitbucket-server" else ("https://" + host + "/" + ns + "/" + r.repo) -%}
{#- file URL = blobPre + path + blobSuf ; folder URL = treePre + path + treeSuf -#}
{%- set blobSuf = ("?at=refs/heads/" + values.branch) if scm == "bitbucket-server" else "" -%}
{%- set treeSuf = blobSuf -%}
{%- if scm == "github" -%}
  {%- set blobPre = webBase + "/blob/" + values.branch + "/" -%}
  {%- set treePre = webBase + "/tree/" + values.branch + "/" -%}
{%- elif scm == "gitlab" -%}
  {%- set blobPre = webBase + "/-/blob/" + values.branch + "/" -%}
  {%- set treePre = webBase + "/-/tree/" + values.branch + "/" -%}
{%- elif scm == "bitbucket-cloud" -%}
  {%- set blobPre = webBase + "/src/" + values.branch + "/" -%}
  {%- set treePre = blobPre -%}
{%- elif scm == "bitbucket-server" -%}
  {%- set blobPre = webBase + "/browse/" -%}
  {%- set treePre = blobPre -%}
{%- else -%}
  {%- set blobPre = webBase + "/src/branch/" + values.branch + "/" -%}
  {%- set treePre = blobPre -%}
{%- endif -%}
{%- set repoWeb = webBase -%}
{%- set folder = "" if (values.application_folder == "." or values.application_folder == "") else values.application_folder + "/" -%}
{%- set app = values.bw_app_name[0] if (values.bw_app_name and values.bw_app_name[0]) else (values.app_dir.split(r/[\\\/]/) | last) -%}
{#- entity names: letters, digits and - _ . only, at most 63 characters; the prefix used for derived entities is kept short -#}
{%- set appId = (app | replace(r/[^A-Za-z0-9._-]+/g, "-")) | truncate(63, true, "") | replace(r/^[-_.]+|[-_.]+$/g, "") -%}
{%- set lid = appId | lower | truncate(26, true, "") | replace(r/[-_.]+$/, "") -%}
{%- set edition = values.bw_edition[1] if (values.bw_edition and values.bw_edition[1]) else "" -%}
{%- set isCE = (edition == "bwcf" or edition == "bwce") -%}
{%- set bwver = values.bw_version[1] if (values.bw_version and values.bw_version[1]) else "" -%}
{%- set appver = (values.bw_app_version[1] | replace(".qualifier", "")) if (values.bw_app_version and values.bw_app_version[1]) else "" -%}
{#- Configuration variables: the application's deployed profile wins over the module's defaults. -#}
{%- set vars = [] -%}
{%- set seen = [] -%}
{%- for n in values.bw_gv_names -%}
  {%- if not n.startsWith("//") and not n.startsWith("BW.") and n not in seen -%}{%- set _ = seen.push(n) -%}{%- set _ = vars.push({ "n": n, "v": values.bw_gv_values[loop.index0] }) -%}{%- endif -%}
{%- endfor -%}
{%- for n in values.bw_mod_gv_names -%}
  {%- if not n.startsWith("//") and not n.startsWith("BW.") and n not in seen -%}{%- set _ = seen.push(n) -%}{%- set _ = vars.push({ "n": n, "v": values.bw_mod_gv_values[loop.index0] }) -%}{%- endif -%}
{%- endfor -%}
{%- set brokerUrl = "" -%}
{%- set jdbcUrl = "" -%}
{%- set queues = [] -%}
{%- for x in vars -%}
  {%- set n = x.n -%}{%- set v = x.v -%}
  {%- if v is string and v != "" -%}
    {%- if brokerUrl == "" and (v.startsWith("tcp://") or v.startsWith("ssl://")) -%}{%- set brokerUrl = v -%}{%- endif -%}
    {%- if jdbcUrl == "" and v.startsWith("jdbc:") -%}{%- set jdbcUrl = v.split("?")[0] -%}{%- endif -%}
    {%- if (n | lower).endsWith("queue") or (n | lower).endsWith("topic") -%}{%- set _ = queues.push({ "var": n, "name": v, "topic": (n | lower).endsWith("topic"), "tech": "JMS" }) -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{#- ===== process analysis (everything below is derived from the .bwp / module.bwm / schema files) ===== -#}
{%- set varNames = [] -%}{%- set varVals = [] -%}
{%- for x in vars -%}{%- set _ = varNames.push(x.n) -%}{%- set _ = varVals.push(x.v) -%}{%- endfor -%}
{%- set svcNames = [] -%}{%- set svcPaths = [] -%}
{%- for s in (values.bw_svc_names or []) -%}{%- set _ = svcNames.push(s.split('"')[1]) -%}{%- endfor -%}
{%- for s in (values.bw_svc_paths or []) -%}{%- set _ = svcPaths.push(s.split('"')[1]) -%}{%- endfor -%}
{%- set pfull = [] -%}{%- set pshort = [] -%}
{%- for f in values.bw_processes -%}{%- set f = f | replace("\\", "/") -%}
  {%- set pn = (values.bw_p_name[loop.index0][0] if (values.bw_p_name and values.bw_p_name[loop.index0] and values.bw_p_name[loop.index0][0]) else ((f.split(r/[\\\/]/) | last).replace(".bwp", ""))) -%}
  {%- set _ = pfull.push(pn) -%}{%- set _ = pshort.push(pn.split(".") | last) -%}
{%- endfor -%}
{#- destinations: configuration variables first, then any destination only named inside an activity -#}
{%- set dests = [] -%}{%- set destNames = [] -%}
{%- for q in queues -%}{%- set _ = dests.push({ "name": q.name, "var": q["var"], "topic": q.topic, "tech": "JMS", "producers": [], "consumers": [] }) -%}{%- set _ = destNames.push(q.name) -%}{%- endfor -%}
{#- Activity registry: one row per plugin. Add a row to teach the importer a new technology.
    p = activity type prefix, tech = label, cat = messaging | http | soap | db | file | other,
    attrs = attribute names (| separated) that hold the destination/target, hint = words that identify
    the connection URL/host among the configuration variables. Kafka and FTL rows follow the plugin
    naming convention (bw.<plugin>.<activity>) and are unverified against real projects. -#}
{%- set reg = [
  { "p": "bw.jms.", "tech": "JMS", "cat": "messaging", "attrs": "destinationName", "hint": "" },
  { "p": "bw.kafka.", "tech": "Kafka", "cat": "messaging", "attrs": "topicName|topic|topics|destinationName", "hint": "bootstrap|kafka" },
  { "p": "bw.ftl.", "tech": "FTL", "cat": "messaging", "attrs": "endpointName|endpoint|publisherName|subscriberName|destinationName", "hint": "ftl|realm" },
  { "p": "bw.rv.", "tech": "Rendezvous", "cat": "messaging", "attrs": "subject|subjectName|sendSubject|listenSubject|destinationName", "hint": "rv|rendezvous" },
  { "p": "bw.mq.", "tech": "IBM MQ", "cat": "messaging", "attrs": "queueName|queue|destinationName", "hint": "mq|queuemanager" },
  { "p": "bw.amqp.", "tech": "AMQP", "cat": "messaging", "attrs": "queueName|queue|destinationName|exchange", "hint": "amqp" },
  { "p": "bw.mqtt.", "tech": "MQTT", "cat": "messaging", "attrs": "topic|topicName|destinationName", "hint": "mqtt" },
  { "p": "bw.http.", "tech": "HTTP", "cat": "http", "attrs": "", "hint": "" },
  { "p": "bw.restjson.rest", "tech": "REST", "cat": "http", "attrs": "", "hint": "" },
  { "p": "bw.soap.", "tech": "SOAP", "cat": "soap", "attrs": "", "hint": "" },
  { "p": "bw.ws.", "tech": "SOAP", "cat": "soap", "attrs": "", "hint": "" },
  { "p": "bw.jdbc.", "tech": "JDBC", "cat": "db", "attrs": "", "hint": "" },
  { "p": "bw.mongodb.", "tech": "MongoDB", "cat": "db", "attrs": "", "hint": "" },
  { "p": "bw.sftp.", "tech": "SFTP", "cat": "file", "attrs": "", "hint": "" },
  { "p": "bw.ftp.", "tech": "FTP", "cat": "file", "attrs": "", "hint": "" },
  { "p": "bw.file.", "tech": "File", "cat": "file", "attrs": "", "hint": "" },
  { "p": "bw.smtp.", "tech": "Email", "cat": "other", "attrs": "", "hint": "" },
  { "p": "bw.email.", "tech": "Email", "cat": "other", "attrs": "", "hint": "" },
  { "p": "bw.tcp.", "tech": "TCP", "cat": "other", "attrs": "", "hint": "" },
  { "p": "bw.salesforce.", "tech": "Salesforce", "cat": "http", "attrs": "", "hint": "" },
  { "p": "bw.sap.", "tech": "SAP", "cat": "other", "attrs": "", "hint": "" }
] -%}
{%- set outApis = [] -%}{%- set outKeys = [] -%}
{%- set procs = [] -%}{%- set bdbg = [] -%}
{%- set typeNames = [] -%}{%- set typeCounts = [] -%}
{%- set extActs = [] -%}
{%- set restEps = [] -%}
{%- set findings = [] -%}
{%- set totalActs = 0 -%}{%- set totalCatches = 0 -%}{%- set logActs = 0 -%}
{%- for f in values.bw_processes -%}{%- set f = f | replace("\\", "/") -%}
  {%- set i = loop.index0 -%}
  {%- set pname = pshort[i] -%}
  {%- set types = [] -%}{%- set tnames = [] -%}
  {%- for t in ((values.bw_p_types[i] if values.bw_p_types else []) or []) -%}
    {%- set ty = t.split('"')[1] -%}{%- set _ = types.push(ty) -%}
    {%- set _ = tnames.push(((values.bw_p_type_names[i][loop.index0].split('"')[1]) if (values.bw_p_type_names and values.bw_p_type_names[i] and values.bw_p_type_names[i][loop.index0]) else "")) -%}
    {%- set k = typeNames.indexOf(ty) -%}
    {%- if k < 0 -%}{%- set _ = typeNames.push(ty) -%}{%- set _ = typeCounts.push(1) -%}{%- else -%}{%- set _ = typeCounts.splice(k, 1, typeCounts[k] + 1) -%}{%- endif -%}
    {%- set totalActs = totalActs + 1 -%}
    {%- if ty.endsWith(".log") -%}{%- set logActs = logActs + 1 -%}{%- endif -%}
  {%- endfor -%}
  {%- set calls = [] -%}
  {%- for c in ((values.bw_p_calls[i] if values.bw_p_calls else []) or []) -%}{%- set cn = (c.split('"')[1].split(".")) | last -%}{%- if cn not in calls -%}{%- set _ = calls.push(cn) -%}{%- endif -%}{%- endfor -%}
  {#- ---- data mappings: each activity's tibex:inputBinding holds an XSLT stylesheet (attribute or element text, XML-escaped) ---- -#}
  {%- set maps = [] -%}
  {%- set pvn = [] -%}{%- for pv in ((values.bw_p_vars[i] if values.bw_p_vars else []) or []) -%}{%- set _ = pvn.push(pv.split('"')[1]) -%}{%- endfor -%}
  {%- set bnd = ((values.bw_p_binds[i] if values.bw_p_binds else []) or []) -%}
  {%- set bown = ((values.bw_p_bind_owner[i] if values.bw_p_bind_owner else []) or []) -%}
  {%- if bnd.length > 0 and bnd.length == bown.length -%}
  {%- for bx0 in bnd -%}
    {%- set bx = ([bx0 | default("", true) | string] | join("")) -%}{%- if bx.length < 20 or ("inputBinding" not in bx) -%}{%- set _ = bdbg.push("process " + pname + ", binding " + loop.index + ": " + ((bx0 | dump) | truncate(160, true, "..."))) -%}{%- endif -%}
    {%- set bact = ((bown[loop.index0] | default("", true) | string).split('"')[1]) or "" -%}
    {%- set emv = (bx | replace(r/^[\s\S]*?\sexpression="([^"]*)"[\s\S]*$/, "$1")) -%}
    {%- set xs = (emv if emv != bx else (bx | replace(r/^[^>]*>/, "") | replace(r/<\/[^>]*>\s*$/, ""))) -%}
    {%- set xs = xs.replace(r/&lt;/g, "<").replace(r/&gt;/g, ">").replace(r/&quot;/g, '"').replace(r/&apos;/g, "'").replace(r/&#xa;|&#10;|&#xd;/g, " ").replace(r/&amp;/g, "&") -%}
    {%- set xs = ([xs] | join("")) -%}
    {%- set path = [] -%}{%- set stk = [] -%}{%- set ctx = [] -%}
    {%- for tk in (xs.match(r/<(?:[^>"']|"[^"]*"|'[^']*')*>|[^<]+/g) or []) -%}
      {%- if tk.startsWith("</") -%}
        {%- if stk.length > 0 -%}{%- set fl = stk.pop() -%}{%- if fl == 1 -%}{%- set _ = path.pop() -%}{%- elif fl == 2 -%}{%- set _ = ctx.pop() -%}{%- endif -%}{%- endif -%}
      {%- elif tk.startsWith("<?") or tk.startsWith("<!") -%}
      {%- elif tk.startsWith("<") -%}
        {%- set tn = (tk.match(r/^<([^\s\/>]+)/) or ["", ""])[1] -%}
        {%- set selfc = tk.endsWith("/>") -%}
        {%- set flag = 0 -%}
        {%- if tn.startsWith("xsl:") -%}
          {%- set sel = (tk.match(r/(?:select|test)="([^"]*)"/) or ["", ""])[1].replace(r/&lt;/g, "<").replace(r/&gt;/g, ">").replace(r/&quot;/g, '"').replace(r/&apos;/g, "'").replace(r/&amp;/g, "&") -%}
          {%- if tn == "xsl:value-of" or tn == "xsl:copy-of" -%}
            {%- set to = (path.slice(1).join("/") if path.length > 1 else (path[0] if path.length == 1 else "")) -%}
            {%- set vm = sel.match(r/\$[A-Za-z_][A-Za-z0-9_.\-]*/g) or [] -%}
            {%- set vs = [] -%}
            {%- for v in vm -%}{%- if v.substring(1).split(".")[0] not in vs and (pvn.length == 0 or v.substring(1).split(".")[0] in pvn) -%}{%- set _ = vs.push(v.substring(1).split(".")[0]) -%}{%- endif -%}{%- endfor -%}
            {%- set pm = sel.match(r/(?:getModuleProperty|getGlobalVariable)\(\s*["'][^"']+["']/g) or [] -%}
            {%- set ps = [] -%}
            {%- for v in pm -%}{%- set _ = ps.push(v.match(r/["']([^"']+)["']/)[1]) -%}{%- endfor -%}
            {%- set _ = maps.push({ "act": bact, "to": to, "expr": sel, "ctx": ctx.join(" > "), "vars": vs, "props": ps, "const": (vs.length == 0 and ps.length == 0 and (sel.match(r/^\s*("[^"]*"|'[^']*'|-?[0-9.]+)\s*$/) != null)) }) -%}
          {%- elif tn == "xsl:for-each" and not selfc -%}{%- set flag = 2 -%}{%- set _ = ctx.push("for each " + sel) -%}
          {%- elif (tn == "xsl:if" or tn == "xsl:when") and not selfc -%}{%- set flag = 2 -%}{%- set _ = ctx.push("when " + sel) -%}
          {%- elif tn == "xsl:otherwise" and not selfc -%}{%- set flag = 2 -%}{%- set _ = ctx.push("otherwise") -%}
          {%- elif tn == "xsl:attribute" and not selfc -%}{%- set flag = 1 -%}{%- set _ = path.push("@" + ((tk.match(r/name="([^"]*)"/) or ["", ""])[1])) -%}
          {%- endif -%}
        {%- elif not selfc -%}
          {%- set flag = 1 -%}{%- set _ = path.push(tn.split(":") | last) -%}
        {%- endif -%}
        {%- if not selfc -%}{%- set _ = stk.push(flag) -%}{%- endif -%}
      {%- else -%}
        {%- set tx = tk.trim().replace(r/&lt;/g, "<").replace(r/&gt;/g, ">").replace(r/&quot;/g, '"').replace(r/&amp;/g, "&") -%}
        {%- if tx != "" and path.length > 1 -%}
          {%- set _ = maps.push({ "act": bact, "to": path.slice(1).join("/"), "expr": '"' + tx + '"', "ctx": ctx.join(" > "), "vars": [], "props": [], "const": true }) -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- endif -%}
  {#- ---- outbound references (REST and SOAP reference bindings) and the activities that invoke them ---- -#}
  {%- set prefs = [] -%}
  {%- set rbs = ((values.bw_p_refs[i] if values.bw_p_refs else []) or []) -%}
  {%- set rbn = ((values.bw_p_ref_names[i] if values.bw_p_ref_names else []) or []) -%}
  {%- if rbs.length > 0 and rbs.length == rbn.length -%}
  {%- for rb in rbs -%}
    {%- set rk = ("SOAP" if ("SOAPReferenceBinding" in rb) else ("REST" if ("RestReferenceBinding" in rb) else "")) -%}
    {%- if rk != "" -%}
      {%- set rloc = (rb.match(r/locationURI="([^"]*)"/) or ["", ""])[1] -%}
      {%- set rsvc = ((rb.match(r/serviceQName="([^"]*)"/) or ["", ""])[1]).split(":") | last -%}
      {%- set rwsdl = (((rb.match(r/wsdlLocation="([^"]*)"/) or ["", ""])[1]).split(r/[\\\/]/) | last).replace("%20", " ") -%}
      {%- set rpath = (rb.match(r/\spath="([^"]*)"/) or ["", ""])[1] -%}
      {%- set rops = [] -%}
      {%- for om in (rb.match(r/operationName="[^"]*"/g) or []) -%}{%- if om.split('"')[1] not in rops -%}{%- set _ = rops.push(om.split('"')[1]) -%}{%- endif -%}{%- endfor -%}
      {%- set rmeth = [] -%}
      {%- for om in (rb.match(r/httpMethod="[^"]*"/g) or []) -%}{%- if om.split('"')[1] not in rmeth -%}{%- set _ = rmeth.push(om.split('"')[1]) -%}{%- endif -%}{%- endfor -%}
      {%- set _ = prefs.push({ "pl": rbn[loop.index0].split('"')[1], "kind": rk, "loc": rloc, "svc": rsvc, "wsdl": rwsdl, "path": rpath, "ops": rops, "meth": rmeth }) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- endif -%}
  {%- set jmsIn = [] -%}{%- set jmsOut = [] -%}{%- set ext = [] -%}
  {%- for a0 in ((values.bw_p_acts[i] if values.bw_p_acts else []) or []) -%}{%- set a = ([a0 | default("", true) | string] | join("")) -%}
    {%- set an = ((values.bw_p_act_names[i][loop.index0].split('"')[1]) if (values.bw_p_act_names and values.bw_p_act_names[i] and values.bw_p_act_names[i][loop.index0]) else "") -%}
    {%- set aty = (a.match(r/activityTypeID="([^"]*)"/) or ["", ""])[1] -%}
    {%- set atl = aty | lower -%}
    {%- set rgi = [] -%}
    {%- for rr in reg -%}{%- if rgi.length == 0 and atl.startsWith(rr.p | lower) -%}{%- set _ = rgi.push(rr) -%}{%- endif -%}{%- endfor -%}
    {%- set tech = (rgi[0].tech if rgi.length > 0 else "") -%}
    {%- set cat = (rgi[0].cat if rgi.length > 0 else "") -%}
    {%- set attrsRe = ((rgi[0].attrs if (rgi.length > 0 and rgi[0].attrs != "") else "destinationName")) -%}
    {%- set dtag = a.match('<attributeBindings[^>]*eAttributeName="(?:' + attrsRe + ')"[^>]*>') -%}
    {%- set dvar = ((dtag[0].match(r/processProperty="([^"]*)"/) or ["", ""])[1]) if dtag else "" -%}
    {%- set dlit = (a.match('(?:' + attrsRe + ')="([^"]*)"') or ["", ""])[1] -%}
    {%- set style = (a.match(r/messagingStyle="([^"]*)"/) or ["", ""])[1] -%}
    {%- set conn = (a.match(r/(?:connectionReference|jdbcSharedResource|httpClientResource|sharedResource|resource|jmsConnection|kafkaConnection|ftlConnection)="([^"]*)"/) or ["", ""])[1] -%}
    {%- set where = (a.match(r/(?:requestURI|url|URL|endpointURL|resourcePath|path|operationName|serviceName)="([^"]*)"/) or ["", ""])[1] -%}
    {%- set sql = (a.match(r/(?:statement|sqlStatement|query)="([^"]*)"/) or ["", ""])[1] -%}
    {%- set dname = (varVals[varNames.indexOf(dvar)] if (dvar != "" and dvar in varNames) else dlit) -%}
    {%- set verb = atl.split(".") | last -%}
    {%- set kind = "" -%}
    {%- if cat == "messaging" -%}
      {%- if tech == "JMS" -%}
        {%- if ("requestreply" in atl) -%}{%- set kind = "request" -%}
        {%- elif ("send" in atl) or ("publish" in atl) -%}{%- set kind = "send" -%}
        {%- elif ("receive" in atl) or ("get" in atl) or ("wait" in atl) or ("listen" in atl) -%}{%- set kind = "receive" -%}
        {%- endif -%}
      {%- elif ("request" in verb) -%}{%- set kind = "request" -%}
      {%- elif ("receive" in verb) or ("get" in verb) or ("wait" in verb) or ("listen" in verb) or ("subscri" in verb) or ("consum" in verb) or ("poll" in verb) or ("signal" in verb) -%}{%- set kind = "receive" -%}
      {%- elif ("send" in verb) or ("publish" in verb) or ("produc" in verb) or ("reply" in verb) -%}{%- set kind = "send" -%}
      {%- endif -%}
    {%- endif -%}
    {%- if kind != "" and dname != "" and (dname | string) != "" -%}
      {%- set dn = dname | string -%}
      {%- set dkey = dn if tech == "JMS" else (tech + ":" + dn) -%}
      {%- set di = destNames.indexOf(dkey) -%}
      {%- if di < 0 -%}{%- set _ = dests.push({ "name": dn, "var": dvar, "topic": ((style == "Topic") if tech == "JMS" else (tech == "Kafka" or tech == "MQTT")), "tech": tech, "producers": [], "consumers": [] }) -%}{%- set _ = destNames.push(dkey) -%}{%- set di = destNames.length - 1 -%}{%- endif -%}
      {%- if kind == "receive" -%}
        {%- if pname not in dests[di].consumers -%}{%- set _ = dests[di].consumers.push(pname) -%}{%- endif -%}{%- if dn not in jmsIn -%}{%- set _ = jmsIn.push((tech + " " + dn) if tech != "JMS" else dn) -%}{%- endif -%}
      {%- else -%}
        {%- if pname not in dests[di].producers -%}{%- set _ = dests[di].producers.push(pname) -%}{%- endif -%}{%- if dn not in jmsOut -%}{%- set _ = jmsOut.push((tech + " " + dn) if tech != "JMS" else dn) -%}{%- endif -%}
      {%- endif -%}
    {%- endif -%}
    {#- literal values mapped into target-looking fields (host, URI, topic, table...) -#}
    {%- set hints = [] -%}
    {%- for m in maps -%}
      {%- if m.act == an and m.const and hints.length < 4 and (m.to | lower).match(r/(uri|url|host|port|path|topic|subject|queue|endpoint|file|table|method|resource)/) -%}{%- set _ = hints.push((m.to.split(r/[\\\/]/) | last) + " = " + m.expr) -%}{%- endif -%}
    {%- endfor -%}
    {%- set detail = (("destination " + (dname | string)) if (dname | string) != "" else (where if where != "" else "")) -%}
    {%- set _ = ext.push({ "name": an, "type": aty, "conn": conn, "detail": detail, "sql": sql, "kind": kind, "tech": tech, "cat": cat, "hints": hints }) -%}
    {%- set _ = extActs.push({ "proc": pname, "name": an, "type": aty, "conn": conn, "detail": detail, "sql": sql, "kind": kind, "tech": tech, "cat": cat, "hints": hints }) -%}
    {#- an HTTP client resource is an outbound API of its own -#}
    {%- if tech == "HTTP" and conn != "" and atl.endsWith("sendhttprequest") -%}
      {%- set akey = "http:" + conn -%}
      {%- set ai = outKeys.indexOf(akey) -%}
      {%- if ai < 0 -%}{%- set _ = outKeys.push(akey) -%}{%- set _ = outApis.push({ "key": akey, "kind": "HTTP", "name": ((hints | join(" ")).match(r/(?:RequestURI|URL|URI|Host) = "([^"]*)"/) or ["", conn])[1] or conn, "loc": "", "path": "", "svc": "", "wsdl": "", "ops": [], "meth": [], "hints": [], "procs": [], "acts": [] }) -%}{%- set ai = outApis.length - 1 -%}{%- endif -%}
      {%- if pname not in outApis[ai].procs -%}{%- set _ = outApis[ai].procs.push(pname) -%}{%- endif -%}
      {%- set _ = outApis[ai].acts.push(pname + "." + an) -%}
      {%- for h in hints -%}{%- if h not in outApis[ai].hints -%}{%- set _ = outApis[ai].hints.push(h) -%}{%- endif -%}{%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
  {#- activities that invoke a REST or SOAP reference -#}
  {%- set ivp = ((values.bw_p_invk_pl[i] if values.bw_p_invk_pl else []) or []) -%}
  {%- set ivn = ((values.bw_p_invk_names[i] if values.bw_p_invk_names else []) or []) -%}
  {%- set ivo = ((values.bw_p_invk_ops[i] if values.bw_p_invk_ops else []) or []) -%}
  {%- if ivp.length == ivn.length -%}
  {%- for ip in ivp -%}
    {%- set ipl = ip.split('"')[1] -%}
    {%- set iname = ivn[loop.index0].split('"')[1] -%}
    {%- set iop = ((ivo[loop.index0].split('"')[1]) if (ivo.length == ivp.length) else "") -%}
    {%- for rf in prefs -%}
      {%- if rf.pl == ipl -%}
        {%- set akey = rf.kind + ":" + (rf.svc if rf.svc != "" else (rf.path if rf.path != "" else rf.pl)) -%}
        {%- set ai = outKeys.indexOf(akey) -%}
        {%- if ai < 0 -%}{%- set _ = outKeys.push(akey) -%}{%- set _ = outApis.push({ "key": akey, "kind": rf.kind, "name": (rf.svc if rf.svc != "" else (rf.path if rf.path != "" else rf.pl)), "loc": rf.loc, "path": rf.path, "svc": rf.svc, "wsdl": rf.wsdl, "ops": rf.ops, "meth": rf.meth, "hints": [], "procs": [], "acts": [] }) -%}{%- set ai = outApis.length - 1 -%}{%- endif -%}
        {%- if pname not in outApis[ai].procs -%}{%- set _ = outApis[ai].procs.push(pname) -%}{%- endif -%}
        {%- set _ = outApis[ai].acts.push(pname + "." + iname) -%}
        {%- set idet = rf.kind + " " + ((rf.loc + " ") if rf.loc != "" else "") + (rf.path if rf.path != "" else rf.svc) + ((" operation " + iop) if iop != "" else "") -%}
        {%- set _ = ext.push({ "name": iname, "type": ("bw.soap.invoke" if rf.kind == "SOAP" else "bw.rest.invoke"), "conn": rf.pl, "detail": idet, "sql": "", "kind": "", "tech": rf.kind, "cat": ("soap" if rf.kind == "SOAP" else "http"), "hints": [] }) -%}
        {%- set _ = extActs.push({ "proc": pname, "name": iname, "type": ("bw.soap.invoke" if rf.kind == "SOAP" else "bw.rest.invoke"), "conn": rf.pl, "detail": idet, "sql": "", "kind": "", "tech": rf.kind, "cat": ("soap" if rf.kind == "SOAP" else "http"), "hints": [] }) -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- endif -%}
  {%- set ops = [] -%}
  {%- for o in ((values.bw_p_rest_ops[i] if values.bw_p_rest_ops else []) or []) -%}
    {%- set link = ((values.bw_p_rest_links[i][loop.index0].split('"')[1]) if (values.bw_p_rest_links and values.bw_p_rest_links[i] and values.bw_p_rest_links[i][loop.index0]) else "") -%}
    {%- set si = svcNames.indexOf(link) -%}
    {%- if si >= 0 -%}{%- set _ = restEps.push({ "verb": (o.split('"')[1] | upper), "path": svcPaths[si], "proc": pname }) -%}{%- set _ = ops.push((o.split('"')[1] | upper) + " " + svcPaths[si]) -%}{%- endif -%}
  {%- endfor -%}
  {%- set ncatch = ((values.bw_p_catch[i][0] | int) if (values.bw_p_catch and values.bw_p_catch[i] and values.bw_p_catch[i][0]) else 0) -%}
  {%- set totalCatches = totalCatches + ncatch -%}
  {%- set lifecycle = ("onStartup" in (values.bw_p_rest_ops[i] | join(" "))) if (values.bw_p_rest_ops and values.bw_p_rest_ops[i]) else false -%}
  {%- set timers = [] -%}
  {%- for ty in types -%}{%- if ("timer" in (ty | lower)) -%}{%- set _ = timers.push(ty) -%}{%- endif -%}{%- endfor -%}
  {%- set edges = [] -%}{%- set nodes = [] -%}
  {%- set lnames = [] -%}{%- set ltyp = [] -%}
  {%- for lx0 in ((values.bw_p_links[i] if values.bw_p_links else []) or []) -%}{%- set lx = ([lx0 | default("", true) | string] | join("")) -%}
    {%- set _ = lnames.push((lx.match(r/\sname="([^"]*)"/) or ["", ""])[1]) -%}{%- set _ = ltyp.push((lx.match(r/linkType="([^"]*)"/) or ["", ""])[1]) -%}
  {%- endfor -%}
  {%- set srcs = ((values.bw_p_srcs[i] if values.bw_p_srcs else []) or []) -%}
  {%- set srcn = ((values.bw_p_srcn[i] if values.bw_p_srcn else []) or []) -%}
  {%- set tgts = ((values.bw_p_tgts[i] if values.bw_p_tgts else []) or []) -%}
  {%- set tgtn = ((values.bw_p_tgtn[i] if values.bw_p_tgtn else []) or []) -%}
  {#- each <sources>/<targets> element belongs to exactly one activity (srcn/tgtn, same order); a link joins the activity whose
      <source linkName> equals another activity's <target linkName> -#}
  {%- for sx in srcs -%}
    {%- set si = loop.index0 -%}
    {%- for sm in (sx.match(r/linkName="[^"]*"/g) or []) -%}
      {%- set lname = sm.split('"')[1] -%}
      {%- for tx in tgts -%}
        {%- set ti = loop.index0 -%}
        {%- for tm in (tx.match(r/linkName="[^"]*"/g) or []) -%}
          {%- if tm.split('"')[1] == lname and srcn[si] and tgtn[ti] -%}
            {%- set fa = srcn[si].split('"')[1] -%}{%- set ta = tgtn[ti].split('"')[1] -%}
            {%- set lti = lnames.indexOf(lname) -%}
            {%- set lt = (ltyp[lti] if lti >= 0 else "SUCCESS") -%}
            {%- set cpos = sx.indexOf('linkName="' + lname + '"') -%}
            {%- set crest = sx.substring(cpos + 12 + lname.length) -%}
            {%- set cnxt = crest.indexOf('linkName="') -%}
            {%- set cseg = (crest.substring(0, cnxt) if cnxt >= 0 else crest) -%}
            {%- set cm = cseg.match(r/transitionCondition[^>]*>(?:<!\[CDATA\[)?([^\]<]*)/) -%}
            {%- set _ = edges.push({ "from": fa, "to": ta, "lt": lt, "cond": ((cm[1] | trim) if cm else "") }) -%}
            {%- if fa not in nodes -%}{%- set _ = nodes.push(fa) -%}{%- endif -%}
            {%- if ta not in nodes -%}{%- set _ = nodes.push(ta) -%}{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- for tn in tnames -%}{%- if tn != "" and tn not in nodes -%}{%- set _ = nodes.push(tn) -%}{%- endif -%}{%- endfor -%}
  {#- connected components of the link graph: the main flow, plus each group body and fault handler -#}
  {%- set nn = nodes.length -%}
  {%- set comp = [] -%}{%- set inE = [] -%}
  {%- for n in nodes -%}{%- set _ = comp.push(loop.index0) -%}{%- set _ = inE.push(false) -%}{%- endfor -%}
  {%- for e in edges -%}{%- set _ = inE.splice(nodes.indexOf(e.from), 1, true) -%}{%- set _ = inE.splice(nodes.indexOf(e.to), 1, true) -%}{%- endfor -%}
  {%- for pass in range(nn) -%}{%- for e in edges -%}
    {%- set fi = nodes.indexOf(e.from) -%}{%- set ti = nodes.indexOf(e.to) -%}
    {%- set lo = (comp[fi] if comp[fi] < comp[ti] else comp[ti]) -%}
    {%- if comp[fi] != lo -%}{%- set _ = comp.splice(fi, 1, lo) -%}{%- endif -%}
    {%- if comp[ti] != lo -%}{%- set _ = comp.splice(ti, 1, lo) -%}{%- endif -%}
  {%- endfor -%}{%- endfor -%}
  {%- set si0 = nodes.indexOf("Start") -%}
  {%- set mainRoot = (comp[si0] if si0 >= 0 else (comp[0] if nn > 0 else 0)) -%}
  {%- set croots = [mainRoot] -%}
  {%- for n in nodes -%}{%- if inE[loop.index0] and comp[loop.index0] not in croots -%}{%- set _ = croots.push(comp[loop.index0]) -%}{%- endif -%}{%- endfor -%}
  {%- set cidx = [] -%}
  {%- for n in nodes -%}{%- set _ = cidx.push((croots.indexOf(comp[loop.index0]) if inE[loop.index0] else 0)) -%}{%- endfor -%}
  {%- set glabels = [] -%}{%- set gnames = ((values.bw_p_groups[i] if values.bw_p_groups else []) or []) -%}{%- set gused = [0] -%}
  {%- for rt in croots -%}
    {%- set ri = loop.index0 -%}
    {%- set gflag = [] -%}
    {%- for n in nodes -%}{%- if cidx[loop.index0] == ri and n.match(r/^GroupStart/) -%}{%- set _ = gflag.push(1) -%}{%- endif -%}{%- endfor -%}
    {%- if ri == 0 -%}{%- set _ = glabels.push("") -%}
    {%- elif gflag.length > 0 and gused[0] < gnames.length -%}{%- set _ = glabels.push("Group: " + gnames[gused[0]].split('"')[1]) -%}{%- set _ = gused.splice(0, 1, gused[0] + 1) -%}
    {%- else -%}{%- set _ = glabels.push("Fault or event handler") -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set _ = procs.push({ "comp": cidx, "glabels": glabels, "maps": maps, "edges": edges, "nodes": nodes, "name": pname, "full": pfull[i], "file": f, "types": types, "tnames": tnames, "calls": calls, "ext": ext, "ops": ops, "jmsIn": jmsIn, "jmsOut": jmsOut, "catches": ncatch, "lifecycle": lifecycle, "timers": timers, "calledBy": [] }) -%}
{%- endfor -%}
{%- for p in procs -%}
  {%- for c in p.calls -%}{%- set ci = pshort.indexOf(c) -%}{%- if ci >= 0 and p.name not in procs[ci].calledBy -%}{%- set _ = procs[ci].calledBy.push(p.name) -%}{%- endif -%}{%- endfor -%}
{%- endfor -%}
{#- trigger label per process (parallel arrays), and the entry points the call tree starts from -#}
{%- set trigText = [] -%}{%- set trigKind = [] -%}{%- set roots = [] -%}
{%- for p in procs -%}
  {%- set trig = [] -%}
  {%- if p.ops.length > 0 -%}{%- set _ = trig.push("REST " + (p.ops | join(", "))) -%}{%- endif -%}
  {%- if p.jmsIn.length > 0 -%}{%- set _ = trig.push("JMS " + (p.jmsIn | join(", "))) -%}{%- endif -%}
  {%- if p.timers.length > 0 -%}{%- set _ = trig.push("Timer") -%}{%- endif -%}
  {%- if p.lifecycle -%}{%- set _ = trig.push("Module start/stop") -%}{%- endif -%}
  {%- set kindOf = "entry" -%}
  {%- if trig.length == 0 -%}
    {%- if p.calledBy.length > 0 -%}{%- set _ = trig.push("Sub-process, called by " + (p.calledBy | join(", "))) -%}{%- set kindOf = "sub" -%}
    {%- else -%}{%- set _ = trig.push("Not referenced by any trigger or process") -%}{%- set kindOf = "orphan" -%}{%- endif -%}
  {%- endif -%}
  {%- set _ = trigText.push(trig | join("; ")) -%}{%- set _ = trigKind.push(kindOf) -%}
  {%- if kindOf != "sub" -%}{%- set _ = roots.push(loop.index0) -%}{%- endif -%}
{%- endfor -%}
{#- call tree: iterative depth-first walk (nunjucks has no recursion without macros), 4 spaces per level for Markdown -#}
{%- set treeLines = [] -%}
{%- for root in roots -%}
  {%- set stack = [{ "i": root, "d": 0 }] -%}
  {%- for step in range(300) -%}
    {%- if stack.length > 0 -%}
      {%- set cur = stack.pop() -%}
      {%- set cp = procs[cur.i] -%}
      {%- set _ = treeLines.push("    ".repeat(cur.d) + "- **" + cp.name + "**" + ((" (" + trigText[cur.i] + ")") if cur.d == 0 else "")) -%}
      {%- if cur.d < 6 -%}
        {%- set kids = [] -%}
        {%- for c in cp.calls -%}{%- set ci = pshort.indexOf(c) -%}{%- if ci >= 0 -%}{%- set _ = kids.unshift({ "i": ci, "d": cur.d + 1 }) -%}{%- endif -%}{%- endfor -%}
        {%- for kid in kids -%}{%- set _ = stack.push(kid) -%}{%- endfor -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{#- REST operations, grouped, and the totals used in the summaries -#}
{%- set restOps = restEps.length -%}
{%- set jmsDestCount = dests.length -%}
{#- ---- findings: things worth a second look, derived from configuration and process structure ---- -#}
{%- set nObf = 0 -%}
{%- for x in vars -%}
  {%- set n = x.n -%}{%- set v = x.v -%}{%- set ln = n | lower -%}
  {%- if v is string and v != "" -%}
    {%- if v.startsWith("#!") -%}{%- set nObf = nObf + 1 -%}
    {%- elif v.startsWith("%%") -%}
    {%- else -%}
      {%- if v.match(r/(^|[^0-9.])((10|127)\.\d{1,3}\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3})([^0-9]|$)/) -%}
        {%- set _ = findings.push({ "level": "Warning", "area": "Configuration", "text": "`" + n + "` holds a hardcoded private IP address. Prefer a host name or an environment-specific value." }) -%}
      {%- endif -%}
      {%- if v.startsWith("http://") and not ("localhost" in v) -%}
        {%- set _ = findings.push({ "level": "Info", "area": "Configuration", "text": "`" + n + "` is an unencrypted http:// URL." }) -%}
      {%- endif -%}
      {%- if ("localhost" in v) or v.startsWith("127.") -%}
        {%- set _ = findings.push({ "level": "Info", "area": "Configuration", "text": "`" + n + "` points at localhost, which will not work once deployed." }) -%}
      {%- endif -%}
      {%- if ("pass" in ln) or ("secret" in ln) or ("token" in ln) or ("credential" in ln) -%}
        {%- set _ = findings.push({ "level": "Warning", "area": "Security", "text": "`" + n + "` looks like a secret but holds a plain value (not shown here). Use an obfuscated password or a secret store." }) -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- if nObf > 0 -%}{%- set _ = findings.push({ "level": "Info", "area": "Security", "text": nObf + " obfuscated password value(s) are present in the configuration. Obfuscation is not encryption, and the values are never copied into the catalog." }) -%}{%- endif -%}
{%- set sleepish = [] -%}
{%- for p in procs -%}
  {%- for ty in p.types -%}
    {%- if ty.endsWith(".sleep") and p.tnames[loop.index0] and p.tnames[loop.index0].match(r/(database|db|query|insert|update|select|call|service|api|http|send|lookup)/i) -%}
      {%- set _ = sleepish.push(p.name + "." + p.tnames[loop.index0]) -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if totalCatches > 0 and p.catches == 0 and p.ext.length > 0 -%}
    {%- set _ = findings.push({ "level": "Info", "area": "Reliability", "text": "`" + p.name + "` calls external systems (" + p.ext.length + " activit" + ("y" if p.ext.length == 1 else "ies") + ") but has no fault handler, unlike other processes in this application." }) -%}
  {%- endif -%}
{%- endfor -%}
{%- if sleepish.length > 0 -%}{%- set _ = findings.push({ "level": "Warning", "area": "Process", "text": sleepish.length + " Sleep activit" + ("y" if sleepish.length == 1 else "ies") + " carry names that suggest real work (" + (sleepish | join(", ")) + "). If these are placeholders for database or service calls, replace them with the real activities." }) -%}{%- endif -%}
{%- for p in procs -%}
  {%- if trigKind[loop.index0] == "orphan" -%}
    {%- set _ = findings.push({ "level": "Info", "area": "Process", "text": "`" + p.name + "` is not called by any process and has no trigger of its own. It may be dead code." }) -%}
  {%- endif -%}
{%- endfor -%}
{%- if procs.length > 0 and logActs == 0 -%}{%- set _ = findings.push({ "level": "Info", "area": "Operability", "text": "No process contains a Log activity, so the application writes no application-level log messages." }) -%}{%- endif -%}
{%- if procs.length > 0 and totalCatches == 0 -%}{%- set _ = findings.push({ "level": "Warning", "area": "Reliability", "text": "None of the " + procs.length + " processes defines a fault handler. Errors will be handled only by the engine defaults." }) -%}{%- endif -%}
{%- if (values.bw_tests or []).length == 0 -%}{%- set _ = findings.push({ "level": "Info", "area": "Testing", "text": "No BusinessWorks test suites were found under a Tests folder." }) -%}{%- endif -%}
{%- set totalMaps = 0 -%}{%- for p in procs -%}{%- set totalMaps = totalMaps + p.maps.length -%}{%- endfor -%}
{%- for ea in extActs -%}
  {%- if ea.sql != "" and ea.sql.match(r/select\s+\*/i) -%}{%- set _ = findings.push({ "level": "Info", "area": "Database", "text": "`" + ea.proc + "." + ea.name + "` selects with `SELECT *`. Naming the columns keeps the mapping stable when the table changes." }) -%}{%- endif -%}
  {%- for h in ea.hints -%}
    {%- if h.match(r/(https?:\/\/|[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})/) -%}{%- set _ = findings.push({ "level": "Warning", "area": "Configuration", "text": "`" + ea.proc + "." + ea.name + "` has a hard-coded address in its input mapping (" + h + "). Move it to a module property or a shared resource." }) -%}{%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- set nWarn = 0 -%}{%- for fnd in findings -%}{%- if fnd.level == "Warning" -%}{%- set nWarn = nWarn + 1 -%}{%- endif -%}{%- endfor -%}
{#- infraMode: per-app (default) | shared-define | shared-reference.
    Shared modes name the broker after its address and queues after broker+destination, so every application
    using the same EMS broker/queue points at the same catalog entity. A Resource ref can only be defined once
    in the catalog: use shared-define for the first import and shared-reference for the rest. -#}
{%- set shared = (values.infraMode == "shared-define" or values.infraMode == "shared-reference") -%}
{%- set brokerHost = brokerUrl.split(",")[0].split("://") | last -%}
{%- set useShared = shared and brokerUrl != "" and not (brokerHost.startsWith("localhost") or brokerHost.startsWith("127.")) -%}
{%- set emitInfra = (not useShared) or values.infraMode == "shared-define" -%}
{%- set brokerSlug = brokerHost | lower | replace(r/[^a-z0-9]+/g, "-") | replace(r/^-+/, "") | replace(r/-+$/, "") -%}
{%- set brokerId = ("ems-" + brokerSlug) if useShared else (lid + "-ems-broker") -%}
{#- clusters for non-JMS messaging (Kafka cluster, FTL realm, ...): found by name among the configuration variables -#}
{%- set tkTech = [] -%}{%- set tkUrl = [] -%}{%- set tkId = [] -%}{%- set tkEmit = [] -%}{%- set tkSlug = [] -%}
{%- for q in dests -%}
  {%- if q.tech != "JMS" and q.tech not in tkTech -%}
    {%- set hintRe = [] -%}{%- for rr in reg -%}{%- if rr.tech == q.tech and rr.hint != "" -%}{%- set _ = hintRe.push(rr.hint) -%}{%- endif -%}{%- endfor -%}
    {%- set urlh = [] -%}
    {%- if hintRe.length > 0 -%}{%- for x in vars -%}{%- if urlh.length == 0 and x.v is string and x.v != "" and (x.n | lower).match(hintRe[0]) and not x.v.startsWith("#!") -%}{%- set _ = urlh.push(x.v) -%}{%- endif -%}{%- endfor -%}{%- endif -%}
    {%- set url = (urlh[0] if urlh.length > 0 else "") -%}
    {%- set tslug = q.tech | lower | replace(r/[^a-z0-9]+/g, "-") -%}
    {%- set shareK = shared and url != "" and not ("localhost" in url) and not url.startsWith("127.") -%}
    {%- set uslug = url.split(",")[0].split("://") | last | lower | replace(r/[^a-z0-9]+/g, "-") | replace(r/^-+|-+$/g, "") -%}
    {%- set _ = tkTech.push(q.tech) -%}{%- set _ = tkUrl.push(url) -%}{%- set _ = tkSlug.push(tslug) -%}
    {%- set _ = tkId.push((((tslug + "-" + uslug) if shareK else (lid + "-" + tslug + "-cluster")) | truncate(63, true, "") | replace(r/[-_.]+$/, ""))) -%}
    {%- set _ = tkEmit.push((not shareK) or values.infraMode == "shared-define") -%}
  {%- endif -%}
{%- endfor -%}
{%- set qids = [] -%}{%- set qEmit = [] -%}{%- set qBroker = [] -%}
{%- for q in dests -%}
  {%- set tk = tkTech.indexOf(q.tech) -%}
  {%- set tkShared = (tk >= 0 and tkUrl[tk] != "" and shared and tkId[tk].startsWith(tkSlug[tk] + "-") and not tkId[tk].startsWith(lid + "-")) -%}
  {%- if q.tech == "JMS" -%}
    {%- set qid = (brokerId + ("-topic-" if q.topic else "-queue-") + (q.name | lower | replace(r/[^a-z0-9._-]+/g, "-"))) if useShared else (lid + "-queue-" + (q.name | lower | replace(" ", "-"))) -%}
    {%- set _ = qEmit.push(emitInfra) -%}{%- set _ = qBroker.push(brokerId if brokerUrl != "" else "") -%}
  {%- else -%}
    {%- set qid = (tkId[tk] + "-" + (q.name | lower | replace(r/[^a-z0-9._-]+/g, "-"))) if tkShared else (lid + "-" + tkSlug[tk] + "-" + (q.name | lower | replace(r/[^a-z0-9._-]+/g, "-"))) -%}
    {%- set _ = qEmit.push(tkEmit[tk]) -%}{%- set _ = qBroker.push(tkId[tk]) -%}
  {%- endif -%}
  {%- set _ = qids.push(qid | truncate(63, true, "") | replace(r/[-_.]+$/, "")) -%}
{%- endfor -%}
{#- database: shared by connection URL in the shared modes; tables read from the SQL of JDBC activities -#}
{%- set dbShared = shared and jdbcUrl != "" and not ("localhost" in jdbcUrl) and not ("127.0.0.1" in jdbcUrl) -%}
{%- set dbId = (("db-" + (jdbcUrl.replace("jdbc:", "") | lower | replace(r/[^a-z0-9]+/g, "-") | replace(r/^-+|-+$/g, ""))) | truncate(63, true, "") | replace(r/[-_.]+$/, "")) if dbShared else (lid + "-database") -%}
{%- set emitDb = (not dbShared) or values.infraMode == "shared-define" -%}
{%- set dbTables = [] -%}{%- set dbTableKeys = [] -%}
{%- for ea in extActs -%}
  {%- for tm in (ea.sql.match(r/\b(?:from|join|into|update)\s+[A-Za-z_][A-Za-z0-9_.$]*/gi) or []) -%}
    {%- set tname = tm.split(" ") | last -%}
    {%- set tkey = (tname.split(".") | last) | lower -%}
    {%- if tkey not in ["select", "set", "values", "dual"] and tkey not in dbTableKeys -%}{%- set _ = dbTables.push(tname) -%}{%- set _ = dbTableKeys.push(tkey) -%}{%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{#- outbound REST/SOAP/HTTP dependencies become API entities the application consumes -#}
{%- set oaIds = [] -%}{%- set oaEmit = [] -%}{%- set consumes = [] -%}
{%- for oa in outApis -%}
  {%- set hostSlug = oa.loc.split("://") | last | lower | replace(r/[^a-z0-9]+/g, "-") | replace(r/^-+|-+$/g, "") -%}
  {%- set baseSlug = ((oa.svc if oa.svc != "" else (oa.path if oa.path != "" else oa.name)) | lower | replace(r/[^a-z0-9]+/g, "-") | replace(r/^-+|-+$/g, "")) -%}
  {%- set shareA = shared and oa.loc != "" -%}
  {%- set _ = oaIds.push((("ext-api-" + hostSlug + "-" + (oa.kind | lower) + "-" + baseSlug) if shareA else (lid + "-ref-" + (oa.kind | lower) + "-" + baseSlug)) | truncate(63, true, "") | replace(r/[-_.]+$/, "")) -%}
  {%- set _ = oaEmit.push((not shareA) or values.infraMode == "shared-define") -%}
  {%- set _ = consumes.push("api:default/" + oaIds[loop.index0]) -%}
{%- endfor -%}
{#- WSDL files in Service Descriptors: consumed when an outbound SOAP reference uses them, otherwise provided -#}
{%- set wsdlConsumed = [] -%}
{%- for f in (values.bw_wsdl_files or []) -%}{%- set f = f | replace("\\", "/") -%}
  {%- set wb = (f.split(r/[\\\/]/) | last) -%}{%- set wc = [] -%}
  {%- for oa in outApis -%}{%- if oa.wsdl == wb -%}{%- set _ = wc.push(1) -%}{%- endif -%}{%- endfor -%}
  {%- set _ = wsdlConsumed.push(wc.length > 0) -%}
{%- endfor -%}
{%- set resRefs = [] -%}
{%- set apiRefs = [] -%}
{#- The broker/database hang off the queues and connection resources, so link them straight from the application
    only when nothing else depends on them (avoids redundant edges in the topology view). -#}
{%- set jd = [] -%}{%- for q in dests -%}{%- if q.tech == "JMS" -%}{%- set _ = jd.push(1) -%}{%- endif -%}{%- endfor -%}
{%- set viaJms = jd.length > 0 -%}
{%- set viaJdbc = false -%}
{%- for f in values.bw_resources -%}{%- set f = f | replace("\\", "/") -%}
  {%- set fext = (f.split(r/[\\\/]/) | last).split(".") | last -%}
  {%- if fext == "jmsConnResource" -%}{%- set viaJms = true -%}{%- endif -%}
  {%- if fext == "jdbcResource" -%}{%- set viaJdbc = true -%}{%- endif -%}
{%- endfor -%}
{%- if brokerUrl != "" and not viaJms -%}{%- set _ = resRefs.push("resource:default/" + brokerId) -%}{%- endif -%}
{%- if jdbcUrl != "" and not viaJdbc -%}{%- set _ = resRefs.push("resource:default/" + dbId) -%}{%- endif -%}
{%- for q in dests -%}{%- set _ = resRefs.push("resource:default/" + qids[loop.index0]) -%}{%- endfor -%}
{%- set resNames = [] -%}{%- set apiNames = [] -%}{%- set wsdlNames = [] -%}
{%- for f in values.bw_resources -%}{%- set f = f | replace("\\", "/") -%}{%- set nm0 = ((lid + "-" + ((f.split(r/[\\\/]/) | last).replace(r/\.[^.]*$/, "") | lower)) | replace(r/[^a-z0-9._-]+/g, "-") | replace(r/[-_.]+$/, "")) -%}{%- set nm1 = (nm0 | truncate(63, true, "") | replace(r/[-_.]+$/, "")) -%}{%- set nm1 = ((nm0 | truncate(57, true, "") | replace(r/[-_.]+$/, "")) + "-" + (loop.index0 + 1)) if (nm1 in resNames or nm0.length > 63) else nm1 -%}{%- set _ = resNames.push(nm1) -%}{%- set _ = resRefs.push("resource:default/" + resNames[loop.index0]) -%}{%- endfor -%}
{%- for f in values.bw_swagger_files -%}{%- set f = f | replace("\\", "/") -%}{%- set nm0 = ((lid + "-" + ((f.split(r/[\\\/]/) | last).replace(r/\.[^.]*$/, "") | lower)) | replace(r/[^a-z0-9._-]+/g, "-") | replace(r/[-_.]+$/, "")) -%}{%- set nm1 = (nm0 | truncate(63, true, "") | replace(r/[-_.]+$/, "")) -%}{%- set nm1 = ((nm0 | truncate(57, true, "") | replace(r/[-_.]+$/, "")) + "-" + (loop.index0 + 1)) if (nm1 in apiNames or nm0.length > 63) else nm1 -%}{%- set _ = apiNames.push(nm1) -%}{%- set _ = apiRefs.push("api:default/" + apiNames[loop.index0]) -%}{%- endfor -%}
{%- for f in (values.bw_wsdl_files or []) -%}{%- set f = f | replace("\\", "/") -%}{%- set nm0 = ((lid + "-" + ((f.split(r/[\\\/]/) | last).replace(r/\.[^.]*$/, "") | lower)) | replace(r/[^a-z0-9._-]+/g, "-") | replace(r/[-_.]+$/, "")) -%}{%- set nm1 = (nm0 | truncate(63, true, "") | replace(r/[-_.]+$/, "")) -%}{%- set nm1 = ((nm0 | truncate(57, true, "") | replace(r/[-_.]+$/, "")) + "-" + (loop.index0 + 1)) if (nm1 in wsdlNames or nm0.length > 63) else nm1 -%}{%- set _ = wsdlNames.push(nm1) -%}{%- if not wsdlConsumed[loop.index0] -%}{%- set _ = apiRefs.push("api:default/" + wsdlNames[loop.index0]) -%}{%- elif ("api:default/" + wsdlNames[loop.index0]) not in consumes -%}{%- set _ = consumes.push("api:default/" + wsdlNames[loop.index0]) -%}{%- endif -%}{%- endfor -%}
{%- set tags = ["tibco", "businessworks", ("bwce" if isCE else "bw6")] -%}
{%- for p in values.bw_palettes -%}
  {%- set t = p.replace("name=bw.", "").replace("name=bw", "") | lower | replace(r/[^a-z0-9+#]+/g, "-") | replace(r/^-+|-+$/g, "") | truncate(63, true, "") -%}
  {%- if t != "" and t != "ext" and t != "generalactivities" and t not in tags -%}{%- set _ = tags.push(t) -%}{%- endif -%}
{%- endfor -%}
{%- for ea in extActs -%}{%- set tg = ea.tech | lower | replace(r/[^a-z0-9]+/g, "-") -%}{%- if tg != "" and tg not in tags -%}{%- set _ = tags.push(tg) -%}{%- endif -%}{%- endfor -%}
{%- if dests.length > 0 and "messaging" not in tags -%}{%- set _ = tags.push("messaging") -%}{%- endif -%}
{%- if restOps > 0 and "rest" not in tags -%}{%- set _ = tags.push("rest") -%}{%- endif -%}
{%- set desc = values.bw_app_description[0] if (values.bw_app_description and values.bw_app_description[0]) else ("TIBCO BusinessWorks " + ("Container Edition " if isCE else "") + "application " + app + (" " + appver if appver != "" else "") + " with " + (values.bw_processes.length | string) + " process(es)" + (" providing the " + values.bw_api_title[0] if (values.bw_api_title and values.bw_api_title[0]) else "") + ".") -%}
