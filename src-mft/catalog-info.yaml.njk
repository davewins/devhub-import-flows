{#@@ANALYSIS@@#}
# Generated by the "Import flow for TIBCO MFT" template from the Command Center REST API.
# Repository: ${{ webBase }} (${{ scm }}, branch ${{ values.branch }}), generated ${{ nowIso if nowOk else "(date unknown)" }}.
# Re-running the flow regenerates this file: entity names are stable, removed items disappear. Edit ownership and
# relations that cannot be read from Command Center by hand in a separate file instead.
apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: ${{ ccName | dump }}
  title: ${{ ("MFT Command Center " + inst) | dump }}
  description: ${{ ("TIBCO MFT Command Center " + inst + (" " + ccVersion if ccVersion != "" else "")) | dump }}
  tags: ["mft", "command-center"${{ ', "licence-expiring"' if (licExp != "" and nowOk and licDl <= warnDays) else "" }}]
  links:
    - title: Repository
      url: ${{ webBase | dump }}
{%- if ccUrl != "" %}
    - title: Command Center
      url: ${{ ccUrl | dump }}
{%- endif %}
  annotations:
    backstage.io/source-location: ${{ ("url:" + treePre + (values.outputFolder | trim) + treeSuf) | dump }}
    backstage.io/techdocs-ref: ${{ ("url:" + treePre + (values.outputFolder | trim) + treeSuf) | dump }}
    mft/instance: ${{ inst | dump }}
{%- if nowOk %}
    mft/exported-at: ${{ nowIso | dump }}
{%- endif %}
{%- if ccUrl != "" %}
    mft/command-center-url: ${{ ccUrl | dump }}
{%- endif %}
{%- if ccVersion != "" %}
    mft/version: ${{ ccVersion | dump }}
{%- endif %}
{%- if licExp != "" %}
    mft/license-expires: ${{ (licExp | truncate(10, true, "")) | dump }}
{%- endif %}
    mft/findings: ${{ (findings.length | string) | dump }}
spec:
  type: mft-command-center
  lifecycle: ${{ values.lifecycle | dump }}
  owner: ${{ values.owner | dump }}
  system: ${{ values.system | dump }}
{%- if ccDeps.length > 0 %}
  dependsOn: ${{ ccDeps | dump }}
{%- endif %}
{%- if isName != "" %}
---
apiVersion: backstage.io/v1alpha1
kind: Resource
metadata:
  name: ${{ isName | dump }}
  title: ${{ ("Internet Server " + values.isHost) | dump }}
  description: ${{ ("TIBCO MFT Internet Server " + values.isHost + ": partner-facing FTP / FTPS / SFTP / HTTPS gateway") | dump }}
  tags: ["mft-internet-server"]
  annotations:
    mft/instance: ${{ inst | dump }}
    mft/host: ${{ values.isHost | dump }}
spec:
  type: mft-internet-server
  owner: ${{ values.owner | dump }}
{%- if isDeps.length > 0 %}
  dependsOn: ${{ isDeps | dump }}
{%- endif %}
{%- endif %}
{%- for sv in svs %}
---
apiVersion: backstage.io/v1alpha1
kind: Resource
metadata:
  name: ${{ sv.name | dump }}
  title: ${{ sv.n | dump }}
{%- if sv.desc != "" %}
  description: ${{ sv.desc | dump }}
{%- endif %}
  tags: ${{ sv.tags | dump }}
  annotations:
    mft/instance: ${{ inst | dump }}
    mft/server-type: ${{ sv.typ | dump }}
    mft/address: ${{ sv.addr | dump }}
    mft/port: ${{ sv.port | dump }}
{%- if sv.sec != "" %}
    mft/security: ${{ sv.sec | dump }}
{%- endif %}
{%- if sv.exp != "" %}
    mft/cert-expires: ${{ (sv.exp | truncate(10, true, "")) | dump }}
{%- endif %}
{%- if sv.good != "" %}
    mft/status-good: ${{ sv.good | dump }}
    mft/status-fail: ${{ sv.fail | dump }}
{%- endif %}
spec:
  type: mft-server
  owner: ${{ values.owner | dump }}
{%- if sv.deps.length > 0 %}
  dependsOn: ${{ sv.deps | dump }}
{%- endif %}
{%- endfor %}
{%- for ep in eps %}
---
apiVersion: backstage.io/v1alpha1
kind: Resource
metadata:
  name: ${{ ep.name | dump }}
  title: ${{ (ep.host + " " + ep.proto) | dump }}
  description: ${{ ("Internet Server " + ep.proto + " listener on " + ep.host + ":" + ep.port) | dump }}
  tags: ${{ ep.tags | dump }}
  annotations:
    mft/instance: ${{ inst | dump }}
    mft/host: ${{ ep.host | dump }}
    mft/port: ${{ ep.port | dump }}
    mft/protocol: ${{ ep.proto | dump }}
{%- if ep.exp != "" %}
    mft/cert-expires: ${{ (ep.exp | truncate(10, true, "")) | dump }}
{%- endif %}
spec:
  type: mft-protocol-endpoint
  owner: ${{ values.owner | dump }}
{%- if ep.certId != "" %}
  dependsOn: ${{ ["resource:default/" + nm(inst, "cert", ep.certId)] | dump }}
{%- endif %}
{%- endfor %}
{%- for us in uss %}
---
apiVersion: backstage.io/v1alpha1
kind: Resource
metadata:
  name: ${{ us.name | dump }}
  title: ${{ us.id | dump }}
{%- if us.full != "" %}
  description: ${{ us.full | dump }}
{%- endif %}
  tags: ${{ us.tags | dump }}
  annotations:
    mft/instance: ${{ inst | dump }}
    mft/user-type: ${{ us.type | dump }}
    mft/protocols-allowed: ${{ us.prot | dump }}
{%- if us.ip != "" %}
    mft/ip-restriction: ${{ us.ip | dump }}
{%- endif %}
{%- if us.last != "" %}
    mft/last-access: ${{ us.last | dump }}
{%- endif %}
spec:
  type: mft-partner-user
  owner: ${{ values.owner | dump }}
{%- if us.deps.length > 0 %}
  dependsOn: ${{ us.deps | dump }}
{%- endif %}
{%- endfor %}
{%- for c in certRows %}
---
apiVersion: backstage.io/v1alpha1
kind: Resource
metadata:
  name: ${{ c.name | dump }}
  title: ${{ (c.type + " certificate " + c.label) | dump }}
  description: ${{ (c.desc if c.desc != "" else (("Stored server certificate" if c.kind == "stored" else "System key") + " (" + c.type + ")")) | dump }}
  tags: ${{ c.tags | dump }}
  annotations:
    mft/instance: ${{ inst | dump }}
    mft/key-id: ${{ c.id | dump }}
    mft/key-type: ${{ c.type | dump }}
{%- if c.expires != "" %}
    mft/cert-expires: ${{ (c.expires | truncate(10, true, "")) | dump }}
{%- endif %}
{%- if c.subject != "" %}
    mft/subject: ${{ c.subject | dump }}
{%- endif %}
{%- if c.issuer != "" %}
    mft/issuer: ${{ c.issuer | dump }}
{%- endif %}
spec:
  type: certificate
  owner: ${{ values.owner | dump }}
{%- endfor %}
{%- for t in pts %}
---
apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: ${{ t.name | dump }}
  title: ${{ t.id | dump }}
{%- if t.desc != "" %}
  description: ${{ t.desc | dump }}
{%- endif %}
  tags: ${{ t.tags | dump }}
  annotations:
    mft/instance: ${{ inst | dump }}
    mft/transfer-id: ${{ t.id | dump }}
    mft/family: platform-server
    mft/direction: ${{ t.dir | dump }}
    mft/initiator: ${{ t.ini | dump }}
    mft/source: ${{ t.src | dump }}
    mft/responder: ${{ (t.respHost + ":" + t.respPort) | dump }}
    mft/destination: ${{ t.respFile | dump }}
    mft/ssl: ${{ t.ssl | dump }}
    mft/encryption: ${{ t.enc | dump }}
    mft/compression: ${{ t.comp | dump }}
    mft/hold: ${{ t.hold | dump }}
{%- if t.last != "" %}
    mft/last-processed: ${{ t.last | dump }}
{%- endif %}
{%- if t.exp != "" %}
    mft/cert-expires: ${{ (t.exp | truncate(10, true, "")) | dump }}
{%- endif %}
spec:
  type: file-transfer
  lifecycle: ${{ values.lifecycle | dump }}
  owner: ${{ values.owner | dump }}
{%- if t.deps.length > 0 %}
  dependsOn: ${{ t.deps | dump }}
{%- endif %}
{%- endfor %}
{%- for t in its %}
---
apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: ${{ t.name | dump }}
  title: ${{ t.id | dump }}
{%- if t.desc != "" %}
  description: ${{ t.desc | dump }}
{%- endif %}
  tags: ${{ t.tags | dump }}
  annotations:
    mft/instance: ${{ inst | dump }}
    mft/transfer-id: ${{ t.id | dump }}
    mft/family: internet-server
    mft/direction: ${{ t.dir | dump }}
    mft/user: ${{ t.user | dump }}
    mft/server: ${{ t.server | dump }}
    mft/remote-path: ${{ t.path | dump }}
    mft/protocols-allowed: ${{ t.prot | dump }}
    mft/one-time: ${{ t.oneTime | dump }}
{%- if t.last != "" %}
    mft/last-processed: ${{ t.last | dump }}
{%- endif %}
{%- if t.exp != "" %}
    mft/cert-expires: ${{ (t.exp | truncate(10, true, "")) | dump }}
{%- endif %}
spec:
  type: file-transfer
  lifecycle: ${{ values.lifecycle | dump }}
  owner: ${{ values.owner | dump }}
{%- if t.deps.length > 0 %}
  dependsOn: ${{ t.deps | dump }}
{%- endif %}
{%- endfor %}
{%- if values.createSystem %}
---
apiVersion: backstage.io/v1alpha1
kind: System
metadata:
  name: ${{ values.system | dump }}
  description: ${{ ("TIBCO MFT estate " + inst) | dump }}
spec:
  owner: ${{ values.owner | dump }}
{%- if values.domain %}
  domain: ${{ values.domain | dump }}
{%- endif %}
{%- if values.domain %}
---
apiVersion: backstage.io/v1alpha1
kind: Domain
metadata:
  name: ${{ values.domain | dump }}
spec:
  owner: ${{ values.owner | dump }}
{%- endif %}
{%- endif %}
