## Process details

{% for p in procs -%}
{%- set seenT = [] -%}
{%- for t in p.types -%}{%- if t not in seenT -%}{%- set _ = seenT.push(t) -%}{%- endif -%}{%- endfor -%}
### ${{ p.name }}

- File: `${{ p.file }}`
- Triggered by: ${{ trigText[loop.index0] }}
{% if p.calledBy.length > 0 -%}
- Called by: ${{ p.calledBy | join(", ") }}
{% endif -%}
{% if seenT.length > 0 -%}
- Activities:
{% for t in seenT -%}
{%- set cnt = 0 -%}{%- for u in p.types -%}{%- if u == t -%}{%- set cnt = cnt + 1 -%}{%- endif -%}{%- endfor -%}
${{ '    ' }}- `${{ t }}` x ${{ cnt }}
{% endfor -%}
{% endif -%}
