No such activities were found.
{% else -%}
| Process | Activity | Technology | Type | Connection | Detail |
|---|---|---|---|---|---|
{% for e in extActs -%}
| ${{ e.proc }} | ${{ e.name if e.name != "" else "-" }} | ${{ e.tech if e.tech != "" else "-" }} | `${{ e.type }}` | ${{ e.conn if e.conn != "" else "-" }} | ${{ (((e.detail + "; " if e.detail != "" else "") + (e.hints | join("; "))) if (e.detail != "" or e.hints.length > 0) else "-") | replace("|", "/") }} |
{% endfor %}
{% endif %}
